{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "Marwa Traders CMS",
  "mainBinaryName": "Marwa Traders CMS",
  "version": "1.0.0",
  "identifier": "com.marwatraders.cms",
  "plugins": {},
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Marwa Traders — Collection Management System",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}