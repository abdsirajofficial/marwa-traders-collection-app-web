{
  "expo": {
    "name": "Marwa Collector",
    "slug": "marwa-traders-collector",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.marwatraders.collector",
      "adaptiveIcon": {
        "backgroundColor": "#0284c7"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
